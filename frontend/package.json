{
  "name": "workbench-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs src",
    "test:architecture": "node --test architecture-tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dependency-cruiser": "^18.7.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
