# docker compose 가 읽는 값 (compose 는 .env 만 기본으로 읽는다)
POSTGRES_DB=personal_ai_workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench

# ── 여기부터는 비밀이다. .env 는 커밋되지 않는다 ──────────────────
# Google Cloud Console > Google Auth Platform > Clients 에서 발급한다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HS256 서명 키 (최소 32바이트). 예: openssl rand -base64 48
# 기본값이 없다 — 채우지 않으면 애플리케이션이 뜨지 않는다
AUTH_JWT_SECRET=

# 로그인 허용 이메일 (쉼표 구분). 비우면 누구나 로그인된다
AUTH_ALLOWED_EMAILS=

# OpenAI API 키. 비우면 OpenAI Provider 가 비활성화될 뿐 기동은 된다
# 공용 이름(OPENAI_API_KEY)을 안 쓰는 것은 다른 도구와 계정을 섞지 않기 위해서다
WORKBENCH_PROVIDER_OPENAI_API_KEY=
