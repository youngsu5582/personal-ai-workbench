POSTGRES_DB=personal_ai_workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench
DB_URL=jdbc:postgresql://localhost:5433/personal_ai_workbench
DB_USERNAME=workbench
DB_PASSWORD=workbench

# Google Cloud Console 에서 발급한 OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 내 토큰 서명 키 (최소 32바이트). 예: openssl rand -base64 48
AUTH_JWT_SECRET=
# 로그인 허용 이메일 (쉼표 구분). 비우면 누구나 로그인된다.
AUTH_ALLOWED_EMAILS=
