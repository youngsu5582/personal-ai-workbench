# Copy to runtime.env locally and fill every placeholder before creating workbench-runtime.
# This file is an example only; runtime.env is ignored by Git.
DB_URL=jdbc:postgresql://postgresql:5432/personal_ai_workbench
DB_USERNAME=workbench
DB_PASSWORD=<same value as postgres-credentials/POSTGRES_PASSWORD>

GOOGLE_CLIENT_ID=<Google OAuth client id>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret>
AUTH_ISSUER=https://api.example.com
AUTH_AUDIENCE=workbench-api
AUTH_JWT_SECRET=<openssl rand -base64 48 result>
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_EMAILS=<allowed Google email>

STORAGE_PROVIDER=s3
STORAGE_PRESIGNED_URL_TTL=15m
STORAGE_S3_BUCKET=workbench
STORAGE_S3_REGION=garage
STORAGE_S3_ENDPOINT=https://s3.example.com
STORAGE_S3_ACCESS_KEY=<Garage access key>
STORAGE_S3_SECRET_KEY=<Garage secret key>
STORAGE_S3_PATH_STYLE_ACCESS=true

# Optional. Leave empty if image generation is not enabled yet.
WORKBENCH_PROVIDER_OPENAI_API_KEY=<OpenAI API key>
