          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.created_at AS \"접수\", j.model AS \"모델\", t.attempt_count AS \"시도\", left(t.failure_reason, 160) AS \"사유\", t.uuid AS \"Task\"\nFROM generation_job_tasks t JOIN generation_jobs j ON j.id = t.job_id\nWHERE t.status = 'FAILED' AND $__timeFilter(t.created_at)\nORDER BY t.created_at DESC LIMIT 20"
