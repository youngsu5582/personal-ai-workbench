              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "아직 호출 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
