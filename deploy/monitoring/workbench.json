{
  "uid": "workbench",
  "title": "Workbench",
  "description": "Provider 가 요청을 잘 처리하고 있는지, 작업이 어디서 막혔는지. 원본은 저장소의 docker/grafana/dashboards/workbench.json 이다.",
  "tags": [
    "workbench"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "한눈에",
      "collapsed": false,
