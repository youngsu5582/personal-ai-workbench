    {
      "id": 9,
      "type": "stat",
      "title": "성공률 (최근 1시간)",
      "description": "끝난 호출 중 성공한 비율. 요청이 드물어 1시간으로 묶는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider) (increase(workbench_provider_call_seconds_count{outcome=\"success\"}[1h])) / sum by (provider) (increase(workbench_provider_call_seconds_count[1h]))",
          "legendFormat": "{{provider}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
