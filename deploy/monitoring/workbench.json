    {
      "id": 15,
      "type": "table",
      "title": "Provider · 모델별",
      "description": "원장에 적힌 호출을 묶었다. 앱 지표와 달리 앱을 다시 띄워도 남는다. 지연은 Provider 호출만의 길이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workbench-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workbench-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT provider AS \"Provider\", model AS \"모델\", count(*) AS \"호출\",\n  round(100.0 * avg(CASE WHEN succeeded THEN 1 ELSE 0 END), 1) AS \"성공률 %\",\n  round(avg(latency_ms) / 1000.0, 1) AS \"평균 지연(초)\",\n  round((percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) / 1000.0)::numeric, 1) AS \"p95 지연(초)\",\n  round(max(latency_ms) / 1000.0, 1) AS \"최대 지연(초)\"\nFROM provider_calls WHERE $__timeFilter(called_at)\nGROUP BY 1, 2 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "timeFrom": "30d"
    },
    {
      "id": 16,
      "type": "table",
      "title": "실패 사유",
      "description": "어떤 실패가 몇 번 났나. 같은 사유가 반복되면 요청을 고칠 일인지 Provider 쪽 문제인지 여기서 가른다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workbench-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workbench-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT failure_kind AS \"종류\", left(failure_reason, 160) AS \"사유\", count(*) AS \"횟수\", max(called_at) AS \"마지막\"\nFROM provider_calls WHERE NOT succeeded AND $__timeFilter(called_at)\nGROUP BY 1, 2 ORDER BY 3 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "timeFrom": "30d"
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "하루 단위 성공 · 실패",
      "description": "원장 기준 하루마다 끝난 호출 수.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workbench-db"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workbench-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(called_at, '1d'), CASE WHEN succeeded THEN '성공' ELSE '실패' END AS metric, count(*) AS value\nFROM provider_calls WHERE $__timeFilter(called_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "timeFrom": "30d"
    },
    {
      "id": 18,
      "type": "row",
      "title": "작업 (DB)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "상태별 Task",
